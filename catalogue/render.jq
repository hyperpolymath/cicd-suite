# SPDX-License-Identifier: MPL-2.0
# Emit standalone page records. Only fixed paths and validated clade IDs form paths.
def link($target; $caption; $page):
  "link:" + (if $page == "CATALOGUE.adoc" then "" else "../../" end) + $target + "[" + $caption + "]";
def count_status($items; $status): [$items[] | select(.status == $status)] | length;
def preamble($title): [
  "// SPDX-License-Identifier: CC-BY-SA-4.0",
  "// Generated by scripts/build-capability-catalogue.sh; edit catalogue/capabilities.json.",
  "= " + $title, ":toc:"
];
def card($e; $page): [
  "[[" + $e.id + "]]", "== " + $e.title, "",
  "*`" + $e.id + "` · " + $e.nature + " · " + $e.status + "*", "",
  $e.summary, "", "*Assurance boundary:* " + $e.limitations, "",
  "* " + link($e.path; "Action definition and inputs"; $page)
] + (if $e.workflow then ["* " + link($e.workflow; "Reusable workflow"; $page)] else [] end)
  + (if $e.template then ["* " + link($e.template; "Caller template"; $page)] else [] end) + [""];
. as $all | .capabilities as $entries |
[
  (.clades[] as $clade |
    "catalogue/clades/\($clade.id).adoc" as $page |
    {path: $page, content: ((preamble($clade.title) + ["", link("CATALOGUE.adoc"; "Back to the Capability Atlas"; $page), "", $clade.summary, ""] +
      [$entries[] | select(.clade == $clade.id) | card(.; $page)[]]) | join("\n"))}),
  {path: "CATALOGUE.adoc", content: ((
    preamble("The CI/CD Capability Atlas") + [
      ":toclevels: 2", "",
      "*Repository assurance, organised by purpose. Discover by clade; choose by nature; adopt with evidence.*", "",
      "*\($entries | length) composite actions · \(.clades | length) clades · two independent discovery axes.*", "",
      "This is a visitor-facing product catalogue, not a repo-chora file, a BoJ cartridge implementation, or a certification scheme. Inspired by BoJ's separation of capability domain from interface/type, it groups existing CI/CD building blocks without moving their paths or changing their behaviour.", "",
      "== Find your route", "",
      "* *Protect credentials:* <<sentinel,Sentinel>> — bounded secret scanning and authoritative result receipts.",
      "* *Establish repository policy:* <<covenant,Covenant>>, <<forge,Forge>> and <<schema,Schema>>.",
      "* *Compile, test or prove:* <<proof,Proof>> — language-specific execution and explicitly labelled source checks.",
      "* *Integrate the ecosystem:* <<bridge,Bridge>> — BoJ applicability, Pons and Panic Attack.",
      "* *Explore signals and future work:* <<observatory,Observatory>> and <<frontier,Frontier>> — no inflated assurance claims.", "",
      "== The clade matrix", "", "[cols=\"2,4,1,1,1,1,1\",options=\"header\"]", "|===",
      "|Clade |Purpose |Total |Enforcing |Tool-dependent |Advisory |Stub"
    ] + [
      .clades[] as $c | [$entries[] | select(.clade == $c.id)] as $group |
      "|<<\($c.id),\($c.title)>> |\($c.summary) |\($group | length) |\(count_status($group; "enforcing")) |\(count_status($group; "tool-dependent")) |\(count_status($group; "advisory")) |\(count_status($group; "stub"))"
    ] + [
      "|===", "", "== Read the assurance labels", "",
      "* *Enforcing (\(count_status($entries; "enforcing"))):* can reject a subject. This is not a guarantee of completeness, applicability, production readiness or formal verification.",
      "* *Tool-dependent (\(count_status($entries; "tool-dependent"))):* requires explicitly supplied validators/toolchains; inspect applicability and not-run behaviour before adoption.",
      "* *Advisory (\(count_status($entries; "advisory"))):* signals and warnings, not an assurance verdict. Some current outputs are simulated or heuristic; each card names the boundary.",
      "* *Stub (\(count_status($entries; "stub"))):* unfinished integration or placeholder. Do not deploy as evidence of a completed check.", "",
      "Nature is a separate axis: a policy-pattern scan is not a compiler, a receipt verifier is not an analyser, and a proof executor is not a proof that every program is correct. These labels are reviewed inventory metadata; tests enforce coverage and consistency, not semantic correctness of every gate.", "",
      "== Browse by nature", "", "[cols=\"2,1,7\",options=\"header\"]", "|===", "|Nature |Count |Capabilities"
    ] + [
      ($entries | group_by(.nature)[]) as $group |
      "|\($group[0].nature) |\($group | length) |" + ([$group[] | link(.path; .title; "CATALOGUE.adoc")] | join(" · "))
    ] + ["|===", ""] + [
      .clades[] as $c | [$entries[] | select(.clade == $c.id)] as $group |
      ["[[" + $c.id + "]]", "== " + $c.title, "", $c.summary, "",
       link("catalogue/clades/\($c.id).adoc"; "Explore this clade — \($group | length) capabilities"; "CATALOGUE.adoc"), "",
       "[cols=\"2,2,2,5\",options=\"header\"]", "|===", "|Capability |Nature |Status |What it does"] +
      [$group[] | "|" + link(.path; .title; "CATALOGUE.adoc") + " |\(.nature) |\(.status) |\(.summary)"] + ["|===", ""] | .[]
    ] + [
      "== Adopt deliberately", "",
      "Start with a reusable workflow/caller template where supplied: it handles orchestration that a bare composite may not. Read the action's inputs, scripts, prerequisites and test controls. Pin an already-published, tested source SHA; update the caller lock and complete dependency closure together. Never turn unavailable tools, absent analysis or skipped work into a green assurance claim.", "",
      "* " + link("templates/estate-audit-caller.yml"; "Estate-audit caller"; "CATALOGUE.adoc"),
      "* " + link(".github/workflows/main-estate-audit.yml"; "Estate-audit orchestration"; "CATALOGUE.adoc"),
      "* " + link("docs/SECRET-SCANNER-ROLLOUT.adoc"; "Secret-scanner rollout and security boundaries"; "CATALOGUE.adoc"),
      "* " + link("docs/GOVERNANCE-AND-SONAR-REPAIR.adoc"; "Governance and Sonar verification guidance"; "CATALOGUE.adoc"),
      "* " + link("docs/CAPABILITY-ASSURANCE.adoc"; "Capability assurance matrix: controls, evidence and limits"; "CATALOGUE.adoc"),
      "* " + link("README.adoc"; "Operational README, known defects and test guidance"; "CATALOGUE.adoc"), "",
      "== Keep the atlas honest", "",
      "The single inventory is " + link("catalogue/capabilities.json"; "catalogue/capabilities.json"; "CATALOGUE.adoc") + ". Every action must appear exactly once in one primary clade; status and nature remain independent. Adding an action without cataloguing it, breaking a target link, duplicating an entry or leaving generated pages stale fails the catalogue checks.", "",
      "[source,shell]", "----", "bash scripts/build-capability-catalogue.sh", "bash scripts/build-capability-catalogue.sh --check", "bash tests/capability-catalogue.sh", "----", ""
    ]) | join("\n"))}
] | .[]
